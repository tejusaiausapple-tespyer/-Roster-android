<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backports cleanly to API 26/27; API 28+ doesn't strictly require it but
         declaring it is harmless and matches AndroidX Biometric's own docs. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- One-shot GPS fix at clock-in/out for geofence verification (Phase D). Foreground-only,
         requested at the point of use; never background location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera-only task-completion proof photos (Phase E); never the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- "Add to Calendar" on a shift (Phase F); falls back to an .ics share when denied. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:name=".RosterApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rosterra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rosterra"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
