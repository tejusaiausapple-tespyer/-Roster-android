<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backports cleanly to API 26/27; API 28+ doesn't strictly require it but
         declaring it is harmless and matches AndroidX Biometric's own docs. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- App-wide offline indicator (Phase K) — a normal, install-time-only permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Haptics vocabulary (Phase L) — only used by Haptics.vibrate's non-Compose call sites; a
         normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- One-shot GPS fix at clock-in/out for geofence verification (Phase D). Foreground-only,
         requested at the point of use; never background location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera-only task-completion proof photos (Phase E); never the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- "Add to Calendar" on a shift (Phase F); falls back to an .ics share when denied. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Local shift-reminder notifications (Phase J). POST_NOTIFICATIONS is runtime-requested on
         API 33+; SCHEDULE_EXACT_ALARM lets reminders fire at the exact wall-clock instant (with a
         graceful inexact fallback when not granted); RECEIVE_BOOT_COMPLETED re-arms them after a
         reboot clears the alarm table. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".RosterApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rosterra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rosterra"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Fired by AlarmManager for a due shift reminder; triggered only by this app's own
             component-targeted PendingIntents, so not exported. -->
        <receiver
            android:name=".notifications.ShiftReminderReceiver"
            android:exported="false" />

        <!-- Re-arms persisted shift reminders after a reboot / app update. Exported so the system
             can deliver the boot broadcast. -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Remote push (Phase J) — token rotation (onNewToken) and incoming FCM messages. -->
        <service
            android:name=".notifications.RosterMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
