<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Bridge theme only — Compose owns in-app theming. Transparent system bars
        so edge-to-edge draws the Compose background behind status + nav chrome.
    -->
    <style name="Theme.Rosterra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/roster_background_light</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
