<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Fully transparent on purpose: the real Rosterra app icon (Assets.xcassets/
         AppIcon.appiconset on iOS) is a single flattened image, used here as the
         adaptive icon's background layer (ic_launcher_background.png) with
         nothing drawn on top. A zero-path vector previously caused adaptive-icon
         inflation to fail on-device (PackageManager fell back to the default
         icon) — this invisible full-canvas path keeps the vector non-empty. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>
